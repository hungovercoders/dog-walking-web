{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "dog-walking-web",
	"main": ".svelte-kit/cloudflare/_worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat"],
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"observability": { "enabled": true },
	// Non-secret configuration. Secrets (CLERK_SECRET_KEY) are set with
	// `wrangler secret put`; PUBLIC_CLERK_PUBLISHABLE_KEY and API_BASE_URL are
	// plain vars - override them per environment in the dashboard or here.
	"vars": {
		"API_BASE_URL": "https://dog-walking-api.griff182uk.workers.dev",
		"PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_ZnVuLWFzcC03MDc1LmNsZXJrLmFjY291bnRzLmRldiQ"
	},
	// Worker Previews (`wrangler preview`, run by .github/workflows/preview.yml)
	// do not inherit the production settings above, so the vars are repeated.
	// CLERK_SECRET_KEY is set once on the Previews Base: in the dashboard under
	// the Worker's Variables and Secrets with the Previews Base toggle, or with
	// `npx wrangler preview base-config secret put CLERK_SECRET_KEY`.
	"previews": {
		"vars": {
			"API_BASE_URL": "https://dog-walking-api.griff182uk.workers.dev",
			"PUBLIC_CLERK_PUBLISHABLE_KEY": "pk_test_ZnVuLWFzcC03MDc1LmNsZXJrLmFjY291bnRzLmRldiQ"
		}
	}
}
